# Production: paste your AWS RDS Postgres URL here (or set it on App Runner / Secrets Manager).
# Example:
# DATABASE_URL=postgresql://USER:PASSWORD@YOUR_RDS_ENDPOINT:5432/amanit?sslmode=require
#
# Local optional only: docker compose up -d  →  localhost:5450
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_RDS_ENDPOINT:5432/amanit?sslmode=require

JWT_SECRET=change-me-in-production
PORT=4000
CORS_ORIGIN=http://localhost:5173
# Shared secret for Place-Order tool (x-webhook-secret header)
WEBHOOK_SECRET=your-tool-webhook-secret
# HMAC secret from ElevenLabs post-call webhook (wsec_…)
ELEVENLABS_WEBHOOK_SECRET=wsec_your_elevenlabs_webhook_secret
# Optional. Used to fetch recordings for calls that arrived before audio was stored.
# Create at https://elevenlabs.io/app/settings/api-keys — the value starts with sk_
ELEVENLABS_API_KEY=
SEED_ADMIN_EMAIL=admin@amanit.com
SEED_ADMIN_PASSWORD=admin123
